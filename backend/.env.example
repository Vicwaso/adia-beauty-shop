# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL_PATH=staff-portal-7f2a/

# Postgres (leave DATABASE_URL unset to use the individual fields below it, for local dev)
DATABASE_URL=
DB_NAME=beauty_shop
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (set USE_CLOUDINARY=True in production)
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# M-Pesa Daraja — get sandbox credentials from developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-backend.onrender.com/api/payments/mpesa-callback/
